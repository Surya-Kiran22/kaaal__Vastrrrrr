# Kaal Vastr — env template. Copy to `.env` and fill in real values.
# NEVER commit `.env`. Only the `VITE_` publishable key belongs in the browser
# bundle; a Supabase secret (`sb_secret_` / `service_role`) key must never reach
# the client — the app refuses to start if one is found in a `VITE_` variable.
#
# Everything below without a `VITE_` prefix is read by Node scripts and Edge
# Functions only. It is invisible to the browser and safe to keep in `.env` as
# long as the file itself stays untracked.

# ---------------------------------------------------------------------------
# Browser (Vite). These two are the only ones the app needs to run.
# ---------------------------------------------------------------------------

# Project URL — Supabase Dashboard → Project Settings → Data API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public / publishable key (safe to ship to the browser; RLS is the guard).
# Accepts either the new `sb_publishable_...` key or the legacy `anon` JWT.
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# ---------------------------------------------------------------------------
# Server-side scripts. Required by every `verify:*` command and by
# `admin:bootstrap`, because they need to read and write rows that RLS hides
# from ordinary sessions.
# ---------------------------------------------------------------------------

# Pooled Postgres connection string. Use the transaction pooler (port 5432) or
# the session pooler (port 6543) — never the direct connection, which IPv6-only
# networks cannot reach. Supabase Dashboard → Project Settings → Database.
#
#   postgresql://postgres.<project-ref>:<password>@<project-ref>.<region>.pooler.supabase.com:6543/postgres
#
# The password is the database password, not the account password.
KV_DB_URL=postgresql://postgres.your-ref:your-db-password@your-ref.region.pooler.supabase.com:6543/postgres

# Email of an EXISTING active admin. `manage-staff` refuses to run without it,
# which is what stops the script from being used to create the first admin.
KV_ADMIN_EMAIL=owner@example.com

# Password for that admin, used by the real-auth checks in `verify:admin`.
# Only that script needs it.
KV_ADMIN_PASS=your-temporary-admin-password

# ---------------------------------------------------------------------------
# Optional. Only needed by `manage-staff invite|confirm|reset` when the Edge
# Function has not been deployed, because creating an auth user requires the
# Admin API and therefore the service-role key.
#
# Prefer deploying the function instead and leaving these unset:
#   supabase secrets set SERVICE_ROLE_KEY=...
#   supabase functions deploy manage-staff
# ---------------------------------------------------------------------------

KV_SERVICE_URL=https://your-project-ref.supabase.co
KV_SERVICE_ROLE_KEY=your_service_role_key

# Where emailed invite/reset links should land. Must be the real public site so
# Supabase's redirect allow-list accepts it.
KV_SITE_URL=https://your-domain.example
