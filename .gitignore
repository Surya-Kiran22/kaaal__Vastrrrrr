# Dependencies
node_modules/
.pnpm-store/
.yarn/

# Build output
dist/
dist-ssr/
build/
*.local

# Environment / secrets
.env
.env.local
.env.*.local
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing / tooling caches
coverage/
.vite/
.eslintcache
*.tsbuildinfo

# Supabase CLI local state (contains the linked project ref and cached
# connection details — never commit)
supabase/.temp/
supabase/.branches/
supabase/.env

# Generated SQL bundles. The migrations in supabase/migrations/ are the source
# of truth; these are rebuilt with `npm run db:bundle` and `npm run db:drift-check`.
supabase/apply-all.sql
supabase/paste-pending.sql
supabase/tests/pre-migration-drift-check.sql
supabase/tests/pre-migration-drift-detail.sql

# Local-only database scaffold for the throwaway Docker test database.
supabase/tests/stub-schemas.sql

# Local verification harness. These drive a live database and need credentials,
# so they stay on the workstation rather than in the repository.
scripts/verify-*.mjs


# Editor & IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Local dev server log
dev.log
